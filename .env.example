# 复制为 .env 后按需修改（环境变量优先级高于 config/config.json）
# 部署到虚拟机时，建议把下面几个路径指到代码目录之外，便于备份与挂载数据盘。

# ---- 路径（VM 部署重点）----
# 数据根目录：SQLite 库与日志都放在它下面
SCHEDULE_DATA_DIR=/var/lib/schedule-agent
# 也可分别指定
# SCHEDULE_DB_PATH=/var/lib/schedule-agent/schedule.db
# SCHEDULE_AUTH_DB_PATH=/var/lib/schedule-agent/auth.db
# SCHEDULE_LOG_DIR=/var/log/schedule-agent
# 配置文件位置
# SCHEDULE_CONFIG=/etc/schedule-agent/config.json

# ---- 大模型 ----
# 意图理解**只靠大模型**。不配 Key 会直接报错（不会用关键词规则乱猜意图）。
# SCHEDULE_LLM_API_KEY=sk-xxx
# SCHEDULE_LLM_BASE_URL=https://api.openai.com/v1
# SCHEDULE_LLM_MODEL=gpt-4o-mini
# DeepSeek 示例（OpenAI 兼容，改这三行即可）：
# SCHEDULE_LLM_API_KEY=sk-xxxxxxxx
# SCHEDULE_LLM_BASE_URL=https://api.deepseek.com/v1
# SCHEDULE_LLM_MODEL=deepseek-chat

# ---- 国际化（i18n）----
# 默认语言：zh-CN / en-US。HTTP 请求可用 Accept-Language 或 ?lang= 覆盖。
# 新增语言：把 <locale>.json 放进 src/schedule_agent/i18n/locales/ 即可，无需改代码。
SCHEDULE_LANGUAGE=zh-CN
# 前端界面语言（不设则跟随 SCHEDULE_LANGUAGE）
# SCHEDULE_UI_LANGUAGE=en-US
# 自定义词典目录（只放要覆盖的几条即可，内置词典仍作为兜底）
# SCHEDULE_LOCALES_DIR=/etc/schedule-agent/locales

# ---- 规则兜底开关（默认 false）----
# false：模型不可用 -> 明确报错，绝不静默降级（推荐）
# true ：模型不可用 -> 退化为关键词规则（闭集，容易猜错意图，仅离线应急用）
SCHEDULE_USE_RULE_FALLBACK=0

# ---- 第三方渠道（每个平台一段，全部可选）----
# 通用命名规则：SCHEDULE_CHANNEL_<渠道名大写>_<字段名大写>
# 也可以写进配置文件：{"channels": {"wecom": {...}}}（可读性更好）
#
# 新增平台不用改代码框架：在 src/schedule_agent/channels/ 下复制 _template 改名即可。
# 外挂渠道（独立包）：SCHEDULE_CHANNEL_PLUGINS=my_pkg.feishu,my_pkg.dingtalk

# -- 企业微信自建应用（五项齐全才启用）--
# 后台路径：企业微信管理端 → 应用管理 → 自建 → 「接收消息」设置 API 接收
# 回调 URL：https://<你的域名>/api/channels/wecom/callback（旧路径 /api/wecom/callback 仍可用）
# SCHEDULE_CHANNEL_WECOM_CORP_ID=ww1234567890abcdef
# SCHEDULE_CHANNEL_WECOM_AGENT_ID=1000002
# SCHEDULE_CHANNEL_WECOM_SECRET=your-app-secret
# SCHEDULE_CHANNEL_WECOM_TOKEN=your-callback-token
# SCHEDULE_CHANNEL_WECOM_AES_KEY=43位字符的EncodingAESKey
# 把企微 UserID 绑定到已有账号（共用同一份日程）；留空则每人独立空间
# SCHEDULE_CHANNEL_WECOM_BIND_MAP={"zhangsan": "jiyu"}
#
# 旧写法 SCHEDULE_WECOM_* 仍然兼容（启动时会提示迁移），但新部署请用上面的名字。

# ---- 提醒 ----
# SCHEDULE_DAILY_SUMMARY_TIME=08:00
# SCHEDULE_LEAD_MINUTES=10
# SCHEDULE_INTERVAL=20

# ---- 服务 ----
# SCHEDULE_API_HOST=0.0.0.0
# SCHEDULE_API_PORT=8000
# SCHEDULE_UI_PORT=7860
# 管理员 Key（留空则关闭管理员能力）；前端连后端地址
# SCHEDULE_ADMIN_API_KEY=
# SCHEDULE_API_URL=http://127.0.0.1:8000
# SCHEDULE_LOG_LEVEL=INFO
