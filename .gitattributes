# 仓库内统一用 LF，避免 Windows 检出后整个仓库 diff 全变
* text=auto eol=lf

# Shell 脚本必须 LF，否则 Linux 上会报 "bad interpreter: /bin/bash^M"
*.sh text eol=lf

# Windows 专用脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.zip binary
*.woff binary
*.woff2 binary
